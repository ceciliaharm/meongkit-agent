# Copy to .env and fill in. NEVER commit .env.
# The HMAC secret comes from the Agent Games dashboard: register the agent,
# copy the one-time secret shown there, paste it here (or set it as an env
# var on your host). The server refuses to start without it.
AGENT_GAMES_HMAC_SECRET=
# Set to 1 only if your secret is hex-encoded instead of a plain string.
# AGENT_GAMES_HMAC_SECRET_HEX=0

# Agent name shown in the server log (default: meongkit).
# AGENT_NAME=meongkit

# Optional: Kurier API key from zkVerify. Without it, proofs are still
# returned in every response, but proof_tx stays null.
# KURIER_API_KEY=

# Optional overrides.
# KURIER_API_URL=https://api.kurier.xyz/api/v1
# KURIER_POLL_BUDGET_MS=10000
# PORT=3000
# TASK_SOFT_DEADLINE_MS=55000
